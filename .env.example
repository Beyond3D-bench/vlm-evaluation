# Copy this file to .env and adapt it to your machine. The real .env is
# ignored by Git and may contain secrets; never commit access tokens.

# Persistent storage for Hugging Face caches, checkpoints, external model
# sources, dependency overlays, datasets, and outputs.
OOS_STORAGE_ROOT="$HOME/scratch"

# Optional overrides. Defaults are derived from OOS_STORAGE_ROOT.
# HF_HOME="$OOS_STORAGE_ROOT/hf_cache"
# HF_HUB_CACHE="$HF_HOME/hub"
# OOS_CHECKPOINT_DIR="$OOS_STORAGE_ROOT/checkpoints"
# OOS_DATA_ROOT="$OOS_STORAGE_ROOT/data"
# OOS_OUTPUT_DIR="$OOS_STORAGE_ROOT/lmms-eval/outputs/oos_videoqa"
# OOS_VIDEO_CACHE_DIR="$OOS_STORAGE_ROOT/oos_video_cache3"
# OOS_OVERLAY_ROOT="$OOS_STORAGE_ROOT/python-overlays"
# OOS_VENV_ROOT="$OOS_STORAGE_ROOT/venvs"

# External source repositories prepared by tools/bootstrap_model_sources.py.
# Use an absolute path if jobs may start outside the repository checkout.
# OOS_MODEL_SOURCE_DIR="$PWD/.model-sources"

# Required only for gated/private Hugging Face repositories.
# HF_TOKEN="hf_..."

# Dataset used by the OOS task.
# OOS_DATASET_JSONL="$OOS_DATA_ROOT/vqa/questions.jsonl"

# Optional system tools and model source overrides.
# FFMPEG_PATH="/path/to/ffmpeg"
# VLM3R_REPO="$OOS_STORAGE_ROOT/VLM-3R"
# SPATIAL_MLLM_REPO="$OOS_STORAGE_ROOT/Spatial-MLLM"
# CAMBRIAN_P_PATH="$OOS_STORAGE_ROOT/cambrian-p"
