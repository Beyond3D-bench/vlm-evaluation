# Optional: copy to .env to save settings between sessions.
# Leave values commented to use shell exports or launcher defaults.

# Storage for environments, model sources, checkpoints, caches, and outputs.
# OOS_STORAGE_ROOT="/absolute/path/to/storage"

# Local dataset, until the Hugging Face release is integrated.
# OOS_DATASET_JSONL="/absolute/path/to/questions.jsonl"

# Only if FFmpeg is not on PATH.
# FFMPEG_PATH="/absolute/path/to/ffmpeg"

# Only for gated/private Hugging Face repositories.
# HF_TOKEN="hf_..."
