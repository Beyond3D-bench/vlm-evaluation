FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/cache/huggingface
ENV HF_DATASETS_CACHE=/cache/huggingface/datasets
ENV TORCH_HOME=/cache/torch
ENV XDG_CACHE_HOME=/cache/xdg

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    ffmpeg \
    git \
    python3.10 \
    python3.10-dev \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m pip install --upgrade pip setuptools wheel

WORKDIR /opt/oos_vlm_evaluation

# Install the CUDA 12.8 PyTorch stack first so the editable repo install
# satisfies its torch dependency from the already-installed CUDA wheels.
COPY constraints-torch-cu128.txt /tmp/constraints-torch-cu128.txt
RUN python3.10 -m pip install \
    torch==2.7.1 \
    torchvision==0.22.1 \
    --index-url https://download.pytorch.org/whl/cu128

COPY . /opt/oos_vlm_evaluation
RUN python3.10 -m pip install -e ".[all]" -c /tmp/constraints-torch-cu128.txt

RUN python3.10 - <<'PY'
import torch
import torchvision
import transformers
print("torch", torch.__version__)
print("torchvision", torchvision.__version__)
print("transformers", transformers.__version__)
PY

